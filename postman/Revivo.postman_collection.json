            "body": {
              "mode": "raw",
              "raw": "{{loginBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Registers a unique test user before logging in; saves the runtime token."
          },
          "response": []
