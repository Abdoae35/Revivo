                  "const models = pm.response.json();",
                  "pm.test('Models are DTOs', () => pm.expect(models).to.be.an('array'));",
                  "if (models.length) { const model = models[0]; pm.collectionVariables.set('carModelId', String(model.id)); const year = Math.min(model.yearEnd || new Date().getFullYear(), new Date().getFullYear() + 1); pm.collectionVariables.set('carImageYear', String(Math.max(model.yearStart || year, year))); }",
                  "pm.test('Model year bounds are present', () => models.forEach(model => { pm.expect(model).to.have.property('yearStart'); pm.expect(model).to.have.property('yearEnd'); }));"
                ]
